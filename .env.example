# Optional backend. The app works fully without these (localStorage only).
# Set them to enable Telegram sync + AI doctor. Both keys are PUBLIC (safe in client).
# Get them from your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
